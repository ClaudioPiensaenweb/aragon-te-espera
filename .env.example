# Directus — variables de producción
# Copiar como .env en el servidor: /var/www/vhosts/aragonteespera.com/directus/.env

PORT=8055
PUBLIC_URL=https://cms.aragonteespera.com

# Base de datos PostgreSQL (crear en Plesk)
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aragon_directus
DB_USER=aragon_directus
DB_PASSWORD=

# Seguridad
SECRET=
ADMIN_EMAIL=admin@piensaenweb.com
ADMIN_PASSWORD=

# Storage
STORAGE_LOCAL_ROOT=./uploads

# CORS
CORS_ENABLED=true
CORS_ORIGIN=https://aragonteespera.com
