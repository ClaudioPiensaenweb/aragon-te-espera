{
  "proyecto": {
    "nombre": "Aragón Te Espera",
    "stack": "html-estatico + directus",
    "descripcion": "Portal turístico de Aragón"
  },
  "deploy": {
    "dominio": "aragonteespera.com",
    "staging_dominio": null,
    "estrategia": "A+D",
    "ci_configured": true,
    "auth_method": "password",
    "entornos": {
      "produccion": { "rama": "main", "auto": true }
    },
    "servicios": {
      "frontend": {
        "tipo": "estatico",
        "destino": "/var/www/vhosts/aragonteespera.com/httpdocs/"
      },
      "directus": {
        "tipo": "nodejs",
        "puerto": 8055,
        "manager": "pm2",
        "destino": "/var/www/vhosts/aragonteespera.com/directus/"
      }
    }
  }
}
